ENVIRONMENT=development
SITE_URL=https://playfulprogramming.com

S3_PUBLIC_URL=http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_KEY_ID=playful
S3_KEY_SECRET=programming
S3_BUCKET=hoof-storage

POSTGRES_USER=postgres
POSTGRES_PASSWORD=unicorn
POSTGRES_URL="postgresql://postgres:unicorn@localhost:5432/postgres"
REDIS_URL="redis://localhost:6379"

HOOF_AUTH_TOKEN=supersecret
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW="10 minutes"
RATE_LIMIT_BAN_THRESHOLD=10

# Optional. Only needed for GitHub-based achievement calculation (issue/PR/commit stats).
# Generate one at github.com/settings/tokens with public repo read access.
GITHUB_TOKEN=

# Required. Used for GitHub App Authentication.
GITHUB_APP_ID=github_app_id
GITHUB_APP_PRIVATE_KEY=Z2l0aHViX3ByaXZhdGVfa2V5Cg==

# Required. Used to verify the X-Hub-Signature-256 header on incoming GitHub webhook
# requests. Generated when configuring the webhook under the repo's Settings > Webhooks.
GITHUB_WEBHOOK_SECRET=github_webhook_secret
