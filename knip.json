{
	"$schema": "./node_modules/knip/schema.json",
	"ignoreDependencies": ["@aws-sdk/types", "openapi-typescript"],
	"workspaces": {
		"apps/worker": {
			"entry": ["src/tasks/*/*.ts"]
		},
		"packages/db": {
			"entry": ["scripts/migrate.ts"]
		},
		"packages/*": {
			"includeEntryExports": true
		}
	}
}
