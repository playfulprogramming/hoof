{
	"name": "e2e",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/e2e/src",
	"projectType": "application",
	"tags": [],
	"targets": {
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "eslint ./src",
				"cwd": "apps/e2e"
			}
		},
		"typegen": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node scripts/typegen.ts",
				"cwd": "apps/e2e"
			},
			"outputs": ["{projectRoot}/src/generated/api-schema.d.ts"],
			"cache": true,
			"inputs": ["{workspaceRoot}/apps/api/**/*"],
			"dependsOn": [
				{
					"projects": "api",
					"target": "dev"
				}
			]
		},
		"build:cert": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node scripts/generate-cert.ts",
				"cwd": "apps/e2e"
			},
			"cache": true,
			"inputs": ["{projectRoot}/scripts/generate-cert.ts"],
			"outputs": ["{projectRoot}/src/generated/*.pem"]
		},
		"build:docker": {
			"dependsOn": ["build:cert"],
			"command": "docker compose --profile e2e build"
		},
		"test:docker:clean": {
			"executor": "nx:run-commands",
			"options": {
				"commands": ["docker compose down -v", "docker compose up -d --wait"],
				"parallel": false
			}
		},
		"test": {
			"dependsOn": ["build:docker", "test:docker:clean"],
			"command": "docker compose --profile e2e up e2e --abort-on-container-exit --attach-dependencies"
		}
	}
}
